{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "message-window",
  "description": "Capabilities for pop-out message windows (msgwin-*)",
  "windows": ["msgwin-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "opener:default",
    "opener:allow-open-url",
    "dialog:default"
  ]
}
